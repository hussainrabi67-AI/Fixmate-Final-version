# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Gemini API key for AI diagnose Edge Function
GEMINI_API_KEY=

# n8n Webhook & AI Agent Configuration
# Live n8n AI Chat Agent Webhook URL:
VITE_N8N_AI_CHAT_WEBHOOK=https://your-n8n-instance.com/webhook/fixmate-ai-chat

# Live n8n Service Request & Dispatch Webhook URL:
VITE_N8N_NEW_SERVICE_REQUEST_WEBHOOK=https://your-n8n-instance.com/webhook/fixmate-service-request
